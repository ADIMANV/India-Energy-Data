{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "cwd": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "web-live-api",
      "cwd": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BACKEND_ORIGIN=https://india-energy-data.vercel.app/api",
        "NEXT_PUBLIC_API_URL=/api",
        "npx",
        "next",
        "dev",
        "-p",
        "3010"
      ],
      "port": 3010
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "gridapi.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web-local-api",
      "cwd": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BACKEND_ORIGIN=http://127.0.0.1:8000",
        "NEXT_PUBLIC_API_URL=/api",
        "npx",
        "next",
        "dev",
        "-p",
        "3020"
      ],
      "port": 3020
    }
  ]
}
